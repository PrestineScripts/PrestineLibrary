local function toCFrame(target)
	local kind = typeof(target)
	if kind == "CFrame" then
		return target
	elseif kind == "Vector3" then
		return CFrame.new(target)
	elseif kind == "Instance" and target:IsA("BasePart") then
		return target.CFrame
	end
end

local function isValidMethod(m)
	return VALID_METHODS[m] == true
end

local function firstValue(v)
	if typeof(v) == "table" then return v[1] end
	return v
end

local function setClipboard(text)
