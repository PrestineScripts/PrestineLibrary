local PROPERTY_DEFS = {
	{
		choice = "WalkSpeed", key = "Speed",
		read = function(h) return h.WalkSpeed end,
		apply = function(h, v) if h.WalkSpeed ~= v then h.WalkSpeed = v end end,
		restore = function(h, v) h.WalkSpeed = v end,
	},
	{
		choice = "Jump Power", key = "Power",
		read = function(h) return h.JumpPower end,
		apply = function(h, v)
			h.UseJumpPower = true
			if h.JumpPower ~= v then h.JumpPower = v end
		end,
		restore = function(h, v)
			h.UseJumpPower = true
			h.JumpPower = v
		end,
	},
}

local function applyProperties(self, store, selection, values)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end

	local dd = self._propsDD
	local chosen = {}
	for _, c in ipairs(selection or {}) do chosen[c] = true end
	values = values or {}
	store.orig = store.orig or {}

	for _, def in ipairs(PROPERTY_DEFS) do
		local want = chosen[def.choice] and not (dd and dd:IsLocked(def.choice)) and tonumber(values[def.key])
		if want then
			if store.orig[def.choice] == nil then store.orig[def.choice] = def.read(hum) end
			def.apply(hum, want)
		elseif store.orig[def.choice] ~= nil then
			def.restore(hum, store.orig[def.choice])
			store.orig[def.choice] = nil
		end
	end
	return false
end

function PrestineManager:SetupPlayer(PrestineLib)
	self:_ensureAttached(PrestineLib)
	self._propsDD, self._camDD = nil, nil

	addSection(self, PrestineLib, "Player", "Player Properties")

	if not self:IsExcluded("Property Overrides") then
		local choices, choiceControls = {}, {}

		if not self:IsExcluded("WalkSpeed") then
			choices[#choices + 1] = "WalkSpeed"
			choiceControls["WalkSpeed"] = {
				{ Key = "Speed", Name = "Speed", Type = "Slider", Min = 0, Max = 500, Default = 16, Increment = 1 },
			}
		end
		if not self:IsExcluded("Jump Power") then
			choices[#choices + 1] = "Jump Power"
			choiceControls["Jump Power"] = {
				{ Key = "Power", Name = "Power", Type = "Slider", Min = 0, Max = 1000, Default = 50, Increment = 1 },
			}
		end
		if not self:IsExcluded("Infinite Jump") then
			choices[#choices + 1] = "Infinite Jump"
		end

		if #choices > 0 then
			local dd = addHybrid(self, PrestineLib, "Player", {
				MainTitle = "Property Overrides",
				Description = "Pick what to override, set its value, then flip the switch",
				ChoiceList = choices,
				ChoiceControls = choiceControls,
				Multiple = true,
				DefaultChoice = {},
				EmptyText = "Nothing selected",
				RequiredText = "Pick a property first",
				WhileOn = function(store, selection, values)
					return applyProperties(self, store, selection, values)
				end,
				WhileCooldown = 0.2,
				ToggleCallback = function(state, store, selection, values)
					if not state then
						applyProperties(self, store, {}, {})
					end
				end,
			})
			self._propsDD = dd

			if dd then
				for _, c in ipairs(choices) do
					register(self, c, choiceHandle(dd, c))
				end
			end
		end
	end

	addSection(self, PrestineLib, "Player", "Player Camera")

	if not self:IsExcluded("Enable Spy POV") and not self:IsExcluded("Select Player") then
		local names = getPlayerNames()
		self._spyTarget = names[1] and Players:FindFirstChild(names[1]) or nil

		local dd = addHybrid(self, PrestineLib, "Player", {
			MainTitle = "Enable Spy POV",
			Description = "Pick a player, then flip the switch to spectate them",
			ChoiceList = names,
			DefaultChoice = names[1],
			Multiple = false,
			EmptyText = "No other players",
			RequiredText = "Pick a player first",
			Callback = function(v)
				local name = firstValue(v)
				self._spyTarget = type(name) == "string" and Players:FindFirstChild(name) or nil

				if self._spyEnabled then
					if self._spyTarget then
						setCameraToPlayer(self._spyTarget)
					else
						resetCamera()
					end
				end
			end,
			ToggleCallback = function(state)
				self._spyEnabled = state
				local cam = getCamera()
				if state then
					self._prevCameraSubject = cam.CameraSubject
					if self._spyTarget then
						setCameraToPlayer(self._spyTarget)
					end
				elseif self._prevCameraSubject then
					cam.CameraSubject = self._prevCameraSubject
					self._prevCameraSubject = nil
				else
					resetCamera()
				end
			end,
		})
		self._camDD = dd

		if PrestineLib.ExcludeFromConfig then PrestineLib:ExcludeFromConfig("Enable Spy POV") end

		if dd then
			register(self, "Select Player", dd)
		end
	end

	if self._playerAddedConn then self._playerAddedConn:Disconnect() end
	if self._playerRemovingConn then self._playerRemovingConn:Disconnect() end

	local function refreshPlayers()
		local dd = self._camDD
		if dd and dd.UpdateDropdown then
			pcall(function() dd:UpdateDropdown(getPlayerNames()) end)
		end
	end

	self._playerAddedConn = Players.PlayerAdded:Connect(function()
		task.defer(refreshPlayers)
	end)

	self._playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
		if self._spyTarget == plr then
			self._spyTarget = nil
			if self._spyEnabled then resetCamera() end
		end
		task.defer(refreshPlayers)
	end)

	if self._infJumpConn then self._infJumpConn:Disconnect() end
	self._infJumpConn = UserInputService.JumpRequest:Connect(function()
		local dd = self._propsDD
		if not dd or not dd:GetToggle() or dd:IsLocked("Infinite Jump") then return end

		local sel = dd:Get()
		if type(sel) ~= "table" or not table.find(sel, "Infinite Jump") then return end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

