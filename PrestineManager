local function applyPerformance()
	local f = PrestineManager._perfFlags
	local low = f.LowGraphics
	local desired = {
		Textures = f.Textures or low,
		Effects = f.Effects or low,
		Lighting = f.Lighting or low,
		Fog = f.Fog or low,
		Shadows = f.Shadows or f.Lighting or low,
		RenderDistance = f.RenderDistance or low,
		Water = f.Water or low,
	}
	for key, handler in pairs(perfHandlers) do
		local want = desired[key]
		if (applied[key] or false) ~= want then
			applied[key] = want
			handler(want)
		end
	end
end

local function getServerForMode(mode)
	local base = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local cursor, best

	for _ = 1, 5 do
		local url = cursor and (base .. "&cursor=" .. cursor) or base
		local ok, data = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(url))
		end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			return best
		end

		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing < s.maxPlayers then
				if mode == "Lowest" then
					if not best or s.playing < best.playing then best = s end
				else
					if mode == "Full" and s.playing >= s.maxPlayers - 1 then return s end
					if not best or s.playing > best.playing then best = s end
				end
			end
		end

		cursor = data.nextPageCursor
		if not cursor then break end
	end
	return best
end

local function moveTo(hum, position, token, timeout)
	local finished, success = false, false
	local conn = hum.MoveToFinished:Connect(function(ok)
		finished, success = true, ok
	end)

	hum:MoveTo(position)

	local t0 = os.clock()
	while not finished do
		if token ~= PrestineManager._token then
			conn:Disconnect()
			return "cancel"
		end
		if os.clock() - t0 > timeout then
			conn:Disconnect()
			return "timeout"
		end
		task.wait(0.05)
	end

	conn:Disconnect()
	return success and "ok" or "timeout"
end

local function walkTo(hum, hrp, cf, token)
	for _ = 1, 2 do
		local path = PathfindingService:CreatePath()
		path:ComputeAsync(hrp.Position, cf.Position)
		if path.Status ~= Enum.PathStatus.Success then return end

		local stuck = false
		for _, wp in ipairs(path:GetWaypoints()) do
			if token ~= PrestineManager._token then return end
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			local result = moveTo(hum, wp.Position, token, 3)
			if result == "cancel" then return end
			if result == "timeout" then
				stuck = true
				break
			end
		end

		if not stuck then return end
	end
end

local function tweenTo(mgr, hrp, cf, token)
	local dist = (hrp.Position - cf.Position).Magnitude
	local speed = math.max(tonumber(mgr.Config.TweenSpeed) or 1, 1)

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(dist / speed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = cf }
	)
	mgr._activeTween = tween

	local completed = false
	local conn = tween.Completed:Connect(function()
		completed = true
	end)

	local lastPos = hrp.Position
	local lastMoveT = os.clock()
	tween:Play()

	while not completed do
		if token ~= mgr._token then
			pcall(function() tween:Cancel() end)
			break
		end

		local p = hrp.Position
		if (p - lastPos).Magnitude > 0.15 then
			lastPos = p
			lastMoveT = os.clock()
		elseif os.clock() - lastMoveT > 2.5 then
			pcall(function() tween:Cancel() end)
			break
		end

		task.wait(0.05)
	end

	conn:Disconnect()
	mgr._activeTween = nil
end

function PrestineManager:GetTabEntry(name)
	for _, entry in ipairs(self.TabRegistry) do
		if entry.Name == name then
			return entry
		end
	end
	return nil
end

function PrestineManager:ApplyProfile(name)
	local profile = self.Profiles[name]
	if not profile then return end
	for k, v in pairs(profile) do
		self.Config[k] = v
	end
	if not isValidMethod(self.Config.TravelMethod) then
		self.Config.TravelMethod = "Teleport"
	end
end

function PrestineManager:SetConfig(k, v)
	if self.Config[k] == nil then return end
	self.Config[k] = v
	if k == "TravelMethod" and not isValidMethod(v) then
		self.Config.TravelMethod = "Teleport"
	end
end

function PrestineManager:Cancel()
	self._token += 1
	self._queue = {}
	self.State.Busy = false
	self.State.CurrentTask = "Cancelled"
	if self._activeTween then
		pcall(function() self._activeTween:Cancel() end)
		self._activeTween = nil
	end
end

function PrestineManager:Enqueue(target)
	table.insert(self._queue, target)
end

function PrestineManager:ClearQueue()
	self._queue = {}
end

function PrestineManager:_travel(cf, token)
	local hum, hrp = getHumanoidRoot()
	local method = self.Config.TravelMethod
	if not isValidMethod(method) then
		method = "Teleport"
		self.Config.TravelMethod = method
	end

	if method == "Teleport" then
		hrp.CFrame = cf
		local delay = tonumber(self.Config.TeleportDelay) or 0
		local t0 = os.clock()
		while os.clock() - t0 < delay do
			if token ~= self._token then return end
			task.wait()
		end
	elseif method == "Tween" then
		tweenTo(self, hrp, cf, token)
	else
		walkTo(hum, hrp, cf, token)
	end
end

function PrestineManager:StartQueue()
	if self.State.Busy then return end
	self.State.Busy = true
	self.State.CurrentTask = "Running"

	self._token += 1
	local token = self._token

	task.spawn(function()
		while #self._queue > 0 and token == self._token do
			local cf = toCFrame(table.remove(self._queue, 1))
			if cf then
				self:_travel(cf, token)
			end
		end

		if token == self._token then
			self.State.Busy = false
			self.State.CurrentTask = "Idle"
		end
	end)
end

function PrestineManager:Travel(target)
	if self.Config.QueueMode then
		self:Enqueue(target)
		self:StartQueue()
	else
		self:Cancel()
		self:Enqueue(target)
		self:StartQueue()
	end
end

function PrestineManager:CustomTravel(target, overrides)
	overrides = overrides or {}
	local cfg = self.Config
	local oldMethod, oldSpeed, oldDelay, oldQueue = cfg.TravelMethod, cfg.TweenSpeed, cfg.TeleportDelay, cfg.QueueMode

	if overrides.Method and isValidMethod(overrides.Method) then
		cfg.TravelMethod = overrides.Method
	end
	if overrides.Speed then
		cfg.TweenSpeed = math.max(1, tonumber(overrides.Speed) or cfg.TweenSpeed)
	end
	if overrides.TeleportDelay then
		cfg.TeleportDelay = math.max(0, tonumber(overrides.TeleportDelay) or 0)
	end
	if overrides.QueueMode ~= nil then
		cfg.QueueMode = overrides.QueueMode and true or false
	end

	self:Travel(target)

	task.spawn(function()
		while self.State.Busy do
			task.wait()
		end
		cfg.TravelMethod, cfg.TweenSpeed, cfg.TeleportDelay, cfg.QueueMode = oldMethod, oldSpeed, oldDelay, oldQueue
	end)
end

function PrestineManager:TravelMultiple(list)
	self:Cancel()
	for _, t in ipairs(list) do
		self:Enqueue(t)
	end
	self:StartQueue()
end

local function bindDeath(self, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	if self._deathConn then self._deathConn:Disconnect() end
	self._deathConn = hum.Died:Connect(function()
		self:Cancel()
		self.State.CurrentTask = "Died"
	end)
end

function PrestineManager:_bindCharacterSafety()
	if self._charConn then self._charConn:Disconnect() end

	self._charConn = player.CharacterAdded:Connect(function(char)
		self:Cancel()
		self.State.CurrentTask = "Respawned"
		task.spawn(bindDeath, self, char)
		task.delay(1, function()
			if self._spyEnabled and self._spyTarget then
				setCameraToPlayer(self._spyTarget)
			end
		end)
	end)

	if player.Character then
		task.spawn(bindDeath, self, player.Character)
	end
end

function PrestineManager:_setOptions(options)
	options = options or {}
	self._initOptions = options
	self._includeSet, self._excludeSet = nil, nil

	local include, exclude = options.IncludeFeatures, options.ExcludeFeatures
	if type(include) == "table" and #include > 0 then
		self._includeSet = {}
		for _, name in ipairs(include) do self._includeSet[name] = true end
	elseif type(exclude) == "table" then
		self._excludeSet = {}
		for _, name in ipairs(exclude) do self._excludeSet[name] = true end
	end
end

function PrestineManager:IsExcluded(featureName)
	if self._includeSet then return not self._includeSet[featureName] end
	if self._excludeSet then return self._excludeSet[featureName] == true end
	return false
end

function PrestineManager:SetupTab(tabName, PrestineLib, options)
	if options then
		self:_setOptions(options)
	elseif not self._initOptions then
		self:_setOptions({})
	end

	local entry = self:GetTabEntry(tabName)
	if not entry then
		warn("[PrestineManager] SetupTab: unknown tab '" .. tostring(tabName) .. "'")
		return false
	end

	if not hasTab(entry.Name) then
		PrestineLib:CreateTab({ { Name = entry.Name, Icon = entry.Icon } })
	end

	self[entry.Setup](self, PrestineLib)
	return true
end

local function addSection(self, lib, tab, title)
	if not self:IsExcluded(title) then
		lib:AddSection({ Tab = tab, MainTitle = title })
	end
end

local function addButton(self, lib, tab, name, subtitle, callback)
	if self:IsExcluded(name) then return nil end
	return lib:AddButton({ Tab = tab, MainName = name, SubTitle = subtitle, Callback = callback })
end

local function addToggle(self, lib, tab, name, default, callback)
	if self:IsExcluded(name) then return nil end
	return lib:AddToggle({ Tab = tab, MainName = name, DefaultState = default, Callback = callback })
end

local function addParagraph(self, lib, tab, title, size)
	if self:IsExcluded(title) then return nil end
	return lib:AddParagraph({ Tab = tab, MainTitle = title, paragraphSize = size, MainContent = "Loading..." })
end

function PrestineManager:SetupHome(PrestineLib)
	self:_bindCharacterSafety()
	self._statusParagraph, self._serverStatusParagraph, self._perfParagraph = nil, nil, nil

	addSection(self, PrestineLib, "Home", "Home Links")

	addButton(self, PrestineLib, "Home", "Copy YouTube", "Copies channel link to clipboard", function()
		if setClipboard("https://www.youtube.com/@PrestineScripts") then
			notify(PrestineLib, "Link Copied!", "YouTube link copied.")
		end
	end)

	addButton(self, PrestineLib, "Home", "Copy Discord", "Copies invite link to clipboard", function()
		if setClipboard("https://discord.com/invite/AEmYSz6g4C") then
			notify(PrestineLib, "Link Copied!", "Discord link copied.")
		end
	end)

	addSection(self, PrestineLib, "Home", "Status & Info")
	self._statusParagraph = addParagraph(self, PrestineLib, "Home", "Character Status", 140)
	self._serverStatusParagraph = addParagraph(self, PrestineLib, "Home", "Server Info", 160)
	self._perfParagraph = addParagraph(self, PrestineLib, "Home", "Performance", 90)

	addSection(self, PrestineLib, "Home", "Queue Management")

	addButton(self, PrestineLib, "Home", "Clear Queue", "Clears all pending travel tasks", function()
		self:ClearQueue()
		notify(PrestineLib, "Queue", "Successfully Cleared Queue!")
	end)

	addButton(self, PrestineLib, "Home", "Cancel Movement", "Stops current travel immediately", function()
		self:Cancel()
		notify(PrestineLib, "Movement", "Successfully Cancelled Movement", 5)
	end)

	self:StartMonitors()
end

function PrestineManager:SetupPlayer(PrestineLib)
	addSection(self, PrestineLib, "Player", "Player Properties")

	if not self:IsExcluded("WalkSpeed") then
		PrestineLib:AddSlider({
			Tab = "Player",
			SliderTitle = "WalkSpeed",
			Min = 0,
			Max = 500,
			DefaultValue = 16,
			Increment = 10,
			Callback = function(v)
				pcall(function() getHumanoid().WalkSpeed = v end)
			end
		})
	end

	if not self:IsExcluded("Jump Power") then
		PrestineLib:AddSlider({
			Tab = "Player",
			SliderTitle = "Jump Power",
			Min = 0,
			Max = 1000,
			DefaultValue = 50,
			Increment = 10,
			Callback = function(v)
				pcall(function()
					local hum = getHumanoid()
					hum.UseJumpPower = true
					hum.JumpPower = v
				end)
			end
		})
	end

	addToggle(self, PrestineLib, "Player", "Infinite Jump", false, function(state)
		self._infJump = state
	end)

	addSection(self, PrestineLib, "Player", "Player Camera")

	local playerDropdown
	local function dropdownNames()
		local names = getPlayerNames()
		return #names > 0 and names or { "None" }
	end

	if not self:IsExcluded("Select Player") then
		local names = dropdownNames()
		self._spyTarget = Players:FindFirstChild(names[1])

		playerDropdown = PrestineLib:AddDropdown({
			Tab = "Player",
			MainTitle = "Select Player",
			ChoiceList = names,
			DefaultChoice = names[1],
			Multiple = false,
			Callback = function(v)
				local name = firstValue(v)
				self._spyTarget = type(name) == "string" and name ~= "None" and Players:FindFirstChild(name) or nil

				if self._spyEnabled then
					if self._spyTarget then
						setCameraToPlayer(self._spyTarget)
					else
						resetCamera()
					end
				end
			end
		})
	end

	addToggle(self, PrestineLib, "Player", "Enable Spy POV", false, function(state)
		self._spyEnabled = state
		local cam = getCamera()
		if state then
			self._prevCameraSubject = cam.CameraSubject
			if self._spyTarget then
				setCameraToPlayer(self._spyTarget)
			end
		elseif self._prevCameraSubject then
			cam.CameraSubject = self._prevCameraSubject
		else
			resetCamera()
		end
	end)

	if self._playerAddedConn then self._playerAddedConn:Disconnect() end
	if self._playerRemovingConn then self._playerRemovingConn:Disconnect() end

	local function refreshPlayers()
		if playerDropdown and playerDropdown.UpdateDropdown then
			pcall(function() playerDropdown:UpdateDropdown(dropdownNames()) end)
		end
	end

	self._playerAddedConn = Players.PlayerAdded:Connect(function()
		task.defer(refreshPlayers)
	end)

	self._playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
		if self._spyTarget == plr then
			self._spyTarget = nil
			if self._spyEnabled then resetCamera() end
		end
		task.defer(refreshPlayers)
	end)

	if self._infJumpConn then self._infJumpConn:Disconnect() end
	self._infJumpConn = UserInputService.JumpRequest:Connect(function()
		if not self._infJump then return end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

