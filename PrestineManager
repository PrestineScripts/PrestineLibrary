function PrestineManager:StartMonitors()
	if self._monitorsStarted then return end
	self._monitorsStarted = true

	if self._uiConn then self._uiConn:Disconnect() end

	local frames = 0
	self._uiConn = RunService.Heartbeat:Connect(function()
		frames += 1
	end)

	local cache = {}
	local function push(key, paragraph, text)
		if paragraph and cache[key] ~= text then
			cache[key] = text
			paragraph:SetContent(text)
		end
	end

	task.spawn(function()
		local last = os.clock()
		local serverTimer = 2

		while self._monitorsStarted do
			task.wait(0.5)

			local now = os.clock()
			local dt = now - last
			last = now

			self._fps = math.floor(frames / math.max(dt, 0.001) + 0.5)
			frames = 0

			if isHomeVisible() then
				push("perf", self._perfParagraph, getPerformanceText(self))

				serverTimer += dt
				if serverTimer >= 2 then
					serverTimer = 0
					push("server", self._serverStatusParagraph, getServerInfoText())
				end

				if self._statusParagraph then
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hum then
						local cfg = self.Config
						local text = string.format(
							"Task: %s\nQueue: %d\nMethod: %s\nTweenSpeed: %s\nTeleportDelay: %s\nWalkSpeed: %g\nJump: %g\nHealth: %.0f/%.0f",
							tostring(self.State.CurrentTask), #self._queue, cfg.TravelMethod,
							tostring(cfg.TweenSpeed), tostring(cfg.TeleportDelay),
							hum.WalkSpeed, hum.UseJumpPower and hum.JumpPower or hum.JumpHeight,
							hum.Health, hum.MaxHealth
						)

						local hrp = char:FindFirstChild("HumanoidRootPart")
						if hrp then
							text ..= "\nState: " .. hum:GetState().Name .. "\nRoot Anchored: " .. tostring(hrp.Anchored)
						end

						push("status", self._statusParagraph, text)
					end
				end
			end
		end
	end)
end

function PrestineManager:Init(PrestineLib, options)
	self:_setOptions(options)
	self:_ensureAttached(PrestineLib)

	if not getgenv()._PrestineMain and self._initOptions.GUIArgs then
		if PrestineLib:CreateGUI(self._initOptions.GUIArgs) == false then return end
	end

	local tabsToInit = self._initOptions.Tabs
	if not tabsToInit then
		tabsToInit = {}
		for _, entry in ipairs(self.TabRegistry) do
			tabsToInit[#tabsToInit + 1] = entry.Name
		end
	end

	local tabsToCreate = {}
	for _, tabName in ipairs(tabsToInit) do
		if not hasTab(tabName) then
			local entry = self:GetTabEntry(tabName)
			tabsToCreate[#tabsToCreate + 1] = { Name = tabName, Icon = entry and entry.Icon or "Info" }
		end
	end
	if #tabsToCreate > 0 then
		PrestineLib:CreateTab(tabsToCreate)
	end

	for _, tabName in ipairs(tabsToInit) do
		local entry = self:GetTabEntry(tabName)
		if entry and hasTab(tabName) then
			self[entry.Setup](self, PrestineLib)
		end
	end
end

return PrestineManager
