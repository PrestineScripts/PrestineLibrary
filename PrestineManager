	addSection(self, PrestineLib, "Settings", "Interface Settings")

	if not self:IsExcluded("Toggle UI") then
		register(self, "Toggle UI", PrestineLib:AddKeybind({
			Tab = "Settings",
			MainTitle = "Toggle UI",
			DefaultKey = Enum.KeyCode.RightShift,
			Callback = function(key)
				PrestineLib:SetGUIHotkey(key)
			end
