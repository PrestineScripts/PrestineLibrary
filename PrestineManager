	end)
end

local function formatUptime(seconds)
	seconds = math.floor(seconds)
	local w = math.floor(seconds / 604800)
	local d = math.floor(seconds / 86400) % 7
	local h = math.floor(seconds / 3600) % 24
	local m = math.floor(seconds / 60) % 60

	local parts = {}
	if w > 0 then parts[#parts + 1] = w .. "w" end
	if d > 0 then parts[#parts + 1] = d .. "d" end
	if h > 0 then parts[#parts + 1] = h .. "h" end
	if m > 0 then parts[#parts + 1] = m .. "m" end
	parts[#parts + 1] = (seconds % 60) .. "s"
	return table.concat(parts, " ")
end

