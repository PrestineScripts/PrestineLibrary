local function setTextures(state)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("Decal") then
			local saved = inst:GetAttribute("Prestine_T")
			if state then
				if saved == nil then inst:SetAttribute("Prestine_T", inst.Transparency) end
				inst.Transparency = 1
			elseif saved ~= nil then
				inst.Transparency = saved
				inst:SetAttribute("Prestine_T", nil)
			end
		end
	end
end

local function setEffects(state)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
			local saved = inst:GetAttribute("Prestine_E")
			if state then
				if saved == nil then inst:SetAttribute("Prestine_E", inst.Enabled) end
				inst.Enabled = false
			elseif saved ~= nil then
				inst.Enabled = saved
				inst:SetAttribute("Prestine_E", nil)
			end
		end
	end
end

local function setLighting(state)
	if state then
		if not orig.Lighting then
			local post = {}
			for _, fx in ipairs(Lighting:GetChildren()) do
				if fx:IsA("PostEffect") then
					post[fx] = fx.Enabled
					fx.Enabled = false
				end
			end
			orig.Lighting = {
				Brightness = Lighting.Brightness,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				Post = post,
			}
		end
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
	elseif orig.Lighting then
		local o = orig.Lighting
		Lighting.Brightness = o.Brightness
		Lighting.Ambient = o.Ambient
		Lighting.OutdoorAmbient = o.OutdoorAmbient
		for fx, enabled in pairs(o.Post) do
			if fx.Parent then fx.Enabled = enabled end
		end
		orig.Lighting = nil
	end
end

local function setFog(state)
	if state then
		if not orig.Fog then
			orig.Fog = { End = Lighting.FogEnd, Start = Lighting.FogStart }
		end
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e6
	elseif orig.Fog then
		Lighting.FogEnd = orig.Fog.End
		Lighting.FogStart = orig.Fog.Start
		orig.Fog = nil
	end
end

local function setShadows(state)
	if state then
		if not orig.Shadows then
			orig.Shadows = { Value = Lighting.GlobalShadows }
		end
		Lighting.GlobalShadows = false
	elseif orig.Shadows then
		Lighting.GlobalShadows = orig.Shadows.Value
		orig.Shadows = nil
	end
end

local function setRenderDistance(state)
	if state then
		if not orig.Streaming then
			orig.Streaming = { Target = workspace.StreamingTargetRadius, Min = workspace.StreamingMinRadius }
		end
		workspace.StreamingMinRadius = 64
		workspace.StreamingTargetRadius = 64
	elseif orig.Streaming then
		workspace.StreamingTargetRadius = orig.Streaming.Target
		workspace.StreamingMinRadius = orig.Streaming.Min
		orig.Streaming = nil
	end
end

local function setWater(state)
	if not Terrain then return end
	if state then
		if not orig.Water then
			orig.Water = {
				WaveSize = Terrain.WaterWaveSize,
				WaveSpeed = Terrain.WaterWaveSpeed,
				Reflectance = Terrain.WaterReflectance,
				Transparency = Terrain.WaterTransparency,
			}
		end
		Terrain.WaterWaveSize = 0
		Terrain.WaterWaveSpeed = 0
		Terrain.WaterReflectance = 0
		Terrain.WaterTransparency = 1
	elseif orig.Water then
		local o = orig.Water
		Terrain.WaterWaveSize = o.WaveSize
		Terrain.WaterWaveSpeed = o.WaveSpeed
		Terrain.WaterReflectance = o.Reflectance
		Terrain.WaterTransparency = o.Transparency
		orig.Water = nil
	end
end

