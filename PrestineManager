function PrestineManager:SetupConfig(PrestineLib)
	if not PrestineLib.gameFolderPath then
		PrestineLib:AddParagraph({
			Tab = "Config",
			MainTitle = "Config Unavailable",
			paragraphSize = 80,
			MainContent = "Call PrestineLib:Set(hubName, gameName) before Init to enable config saving and loading."
		})
		return
	end

	_G.PrestineManagerConfig = self.Config

	local localPath = PrestineLib.gameFolderPath
	local globalPath = PrestineLib.mainFolder and (PrestineLib.mainFolder .. "/_global") or nil
	local autoloadFile = localPath .. "/_autoload.txt"

	if globalPath then
		pcall(function()
			if not isfolder(globalPath) then makefolder(globalPath) end
		end)
	end

	local configScope = "Local"
	local selectedConfig = "Default"
	local configNameInput = "Default"

	local function getCurrentPath()
		return configScope == "Global" and globalPath or localPath
	end

	local function sanitize(name)
		name = tostring(name or ""):gsub("[^%w%-_ ]", ""):match("^%s*(.-)%s*$")
		return name ~= "" and name or "Default"
	end

	local function getProfilesForScope()
		local path = getCurrentPath()
		local list = {}
		if path then
			pcall(function()
				for _, file in ipairs(listfiles(path)) do
					local name = file:match("([^/\\]+)%.json$")
					if name and name:sub(1, 1) ~= "_" then
						list[#list + 1] = name
					end
				end
			end)
		end
		if #list == 0 then list[1] = "Default" end
		return list
	end

	local function saveToScope(name)
		local path = getCurrentPath()
		if not path then return false end

		local data = {}
		for k, v in pairs(PrestineLib.data or {}) do data[k] = v end
		data._ManagerConfig = self.Config

		return (pcall(function()
			if not isfolder(path) then makefolder(path) end
			writefile(path .. "/" .. sanitize(name) .. ".json", HttpService:JSONEncode(data))
		end))
	end

	local function loadFromScope(name)
		local path = getCurrentPath()
		if not path then return false end

		local filePath = path .. "/" .. sanitize(name) .. ".json"
		local decoded
		pcall(function()
			if isfile(filePath) then
				decoded = HttpService:JSONDecode(readfile(filePath))
			end
		end)
		if type(decoded) ~= "table" then return false end

		PrestineLib.data = decoded
		PrestineLib._IsLoading = true

		if type(decoded._ManagerConfig) == "table" then
			for k, v in pairs(decoded._ManagerConfig) do
				if self.Config[k] ~= nil then
					self.Config[k] = v
				end
			end
			if not isValidMethod(self.Config.TravelMethod) then
				self.Config.TravelMethod = "Teleport"
			end
		end

		for cname, comp in pairs(PrestineLib.Registry or {}) do
			local savedVal = decoded[cname]
			if savedVal ~= nil then
				pcall(function() comp:Set(savedVal) end)
			end
		end

		PrestineLib._IsLoading = false
		return true
	end

	local function deleteFromScope(name)
		local path = getCurrentPath()
		if not path then return end
		pcall(function()
			local filePath = path .. "/" .. sanitize(name) .. ".json"
			if isfile(filePath) then delfile(filePath) end
		end)
	end

	local configDropdown
	local overwriteBtnSub, loadBtnSub, delBtnSub, autoBtnSub, saveBtnSub

	local function refreshDropdown()
		if configDropdown and configDropdown.UpdateDropdown then
			task.delay(0.1, function()
				pcall(function() configDropdown:UpdateDropdown(getProfilesForScope()) end)
			end)
		end
	end

	local function updateAllTargetLabels()
		local txt = "Target: " .. tostring(selectedConfig)
		for _, label in ipairs({ overwriteBtnSub, loadBtnSub, delBtnSub, autoBtnSub }) do
			label.Text = txt
		end
	end

	addSection(self, PrestineLib, "Config", "Config Scope")

	if not self:IsExcluded("Scope") then
		PrestineLib:AddDropdown({
			Tab = "Config",
			MainTitle = "Scope",
			Description = "Global = shared across all games.  Local = this game only.",
			ChoiceList = { "Local", "Global" },
			DefaultChoice = "Local",
			Multiple = false,
			Callback = function(v)
				configScope = firstValue(v) == "Global" and "Global" or "Local"
				selectedConfig = "Default"
				updateAllTargetLabels()
				refreshDropdown()
			end
		})
	end

	addSection(self, PrestineLib, "Config", "Config Selection")

	if not self:IsExcluded("Select Config") then
		configDropdown = PrestineLib:AddDropdown({
			Tab = "Config",
			MainTitle = "Select Config",
			Description = "Pick a config from the current scope.",
			ChoiceList = getProfilesForScope(),
			DefaultChoice = "Default",
			Multiple = false,
			Callback = function(v)
				selectedConfig = tostring(firstValue(v) or "Default")
				updateAllTargetLabels()
			end
		})
	end

	if not self:IsExcluded("Config Name") then
		PrestineLib:AddInput({
			Tab = "Config",
			MainTitle = "Config Name",
			PlaceHolder = "Enter config name...",
			Callback = function(v)
				if v and v ~= "" then
					configNameInput = v
					if saveBtnSub then saveBtnSub.Text = "Save As: " .. tostring(v) end
				end
			end
		})
	end

	addSection(self, PrestineLib, "Config", "Config Operations")

	saveBtnSub = getSubtitleLabel(addButton(self, PrestineLib, "Config", "Create / Save Config", "Save As: " .. configNameInput, function()
		local name = sanitize(configNameInput)
		if saveToScope(name) then
			refreshDropdown()
			notify(PrestineLib, "Config", "[" .. configScope .. "] Saved: " .. name)
		else
			notify(PrestineLib, "Config", "Save failed")
		end
	end))

	overwriteBtnSub = getSubtitleLabel(addButton(self, PrestineLib, "Config", "Overwrite Selected Config", "Target: " .. selectedConfig, function()
		if saveToScope(selectedConfig) then
			notify(PrestineLib, "Config", "[" .. configScope .. "] Overwrote: " .. selectedConfig)
		end
	end))

	loadBtnSub = getSubtitleLabel(addButton(self, PrestineLib, "Config", "Load Selected Config", "Target: " .. selectedConfig, function()
		if loadFromScope(selectedConfig) then
			notify(PrestineLib, "Config", "[" .. configScope .. "] Loaded: " .. selectedConfig)
		else
			notify(PrestineLib, "Config", "File not found in " .. configScope .. " scope")
		end
	end))

	delBtnSub = getSubtitleLabel(addButton(self, PrestineLib, "Config", "Delete Selected Config", "Target: " .. selectedConfig, function()
		local deleted = selectedConfig
		deleteFromScope(deleted)
		selectedConfig = "Default"
		updateAllTargetLabels()
		refreshDropdown()
		notify(PrestineLib, "Config", "[" .. configScope .. "] Deleted: " .. deleted)
	end))

	addSection(self, PrestineLib, "Config", "Config Automation")

	autoBtnSub = getSubtitleLabel(addButton(self, PrestineLib, "Config", "Set As Autoload", "Target: " .. selectedConfig, function()
		pcall(function()
			writefile(autoloadFile, configScope .. "|" .. selectedConfig)
		end)
		notify(PrestineLib, "Config", "Autoload → [" .. configScope .. "] " .. selectedConfig)
	end))

	if not self:IsExcluded("Auto Save Component Toggles") then
		PrestineLib:AddSaveToggle({
			Tab = "Config",
			MainName = "Auto Save Component Toggles",
			DefaultState = true
		})
	end

	task.delay(1.5, function()
		pcall(function()
			if not isfile(autoloadFile) then return end
			local raw = readfile(autoloadFile)
			if not raw or raw == "" then return end

			local scope, name = raw:match("^([^|]+)|(.+)$")
			if not scope then
				scope, name = "Local", raw
			end

			local previous = configScope
			configScope = scope == "Global" and "Global" or "Local"
			loadFromScope(name)
			configScope = previous
		end)
	end)
end

function PrestineManager:StartMonitors()
	if self._monitorsStarted then return end
	self._monitorsStarted = true

	if self._uiConn then self._uiConn:Disconnect() end

	local frames, fpsTimer, statusTimer, serverTimer = 0, 0, 0, 0

	self._uiConn = RunService.Heartbeat:Connect(function(dt)
		frames += 1
		fpsTimer += dt
		statusTimer += dt
		serverTimer += dt

		if fpsTimer >= 0.5 then
			self._fps = math.floor(frames / fpsTimer + 0.5)
			frames, fpsTimer = 0, 0
			if self._perfParagraph then
				self._perfParagraph:SetContent(getPerformanceText(self))
			end
		end

		if serverTimer >= 1 then
			serverTimer = 0
			if self._serverStatusParagraph then
				self._serverStatusParagraph:SetContent(getServerInfoText())
			end
		end

		if statusTimer >= 0.25 then
			statusTimer = 0
			if not self._statusParagraph then return end

			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hum then return end

			local cfg = self.Config
			local text = string.format(
				"Task: %s\nQueue: %d\nMethod: %s\nTweenSpeed: %s\nTeleportDelay: %s\nWalkSpeed: %g\nJump: %g\nHealth: %.0f/%.0f",
				tostring(self.State.CurrentTask), #self._queue, cfg.TravelMethod,
				tostring(cfg.TweenSpeed), tostring(cfg.TeleportDelay),
				hum.WalkSpeed, hum.UseJumpPower and hum.JumpPower or hum.JumpHeight,
				hum.Health, hum.MaxHealth
			)

			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				text ..= "\nState: " .. hum:GetState().Name .. "\nRoot Anchored: " .. tostring(hrp.Anchored)
			end

			self._statusParagraph:SetContent(text)
		end
	end)
end

function PrestineManager:Init(PrestineLib, options)
	self:_setOptions(options)

	if not getgenv()._PrestineMain and self._initOptions.GUIArgs then
		if PrestineLib:CreateGUI(self._initOptions.GUIArgs) == false then return end
	end

	local tabsToInit = self._initOptions.Tabs
	if not tabsToInit then
		tabsToInit = {}
		for _, entry in ipairs(self.TabRegistry) do
			tabsToInit[#tabsToInit + 1] = entry.Name
		end
	end

	local tabsToCreate = {}
	for _, tabName in ipairs(tabsToInit) do
		if not hasTab(tabName) then
			local entry = self:GetTabEntry(tabName)
			tabsToCreate[#tabsToCreate + 1] = { Name = tabName, Icon = entry and entry.Icon or "Info" }
		end
	end
	if #tabsToCreate > 0 then
		PrestineLib:CreateTab(tabsToCreate)
	end

	for _, tabName in ipairs(tabsToInit) do
		local entry = self:GetTabEntry(tabName)
		if entry and hasTab(tabName) then
			self[entry.Setup](self, PrestineLib)
		end
	end
end

return PrestineManager
