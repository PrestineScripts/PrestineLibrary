local function applyPerformance()
	local f = PrestineManager._perfFlags
	local low = f.LowGraphics
	local desired = {
		Textures = f.Textures or low,
		Effects = f.Effects or low,
		Lighting = f.Lighting or low,
		Fog = f.Fog or low,
		Shadows = f.Shadows or f.Lighting or low,
		RenderDistance = f.RenderDistance or low,
		Water = f.Water or low,
	}
	for key, handler in pairs(perfHandlers) do
		local want = desired[key]
		if (applied[key] or false) ~= want then
			applied[key] = want
			task.spawn(handler, want)
		end
	end
end

local function getServerForMode(mode)
	local base = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local cursor, best

	for _ = 1, 5 do
		local url = cursor and (base .. "&cursor=" .. cursor) or base
		local ok, data = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(url))
		end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			return best
		end

		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing < s.maxPlayers then
				if mode == "Lowest" then
					if not best or s.playing < best.playing then best = s end
				else
					if mode == "Full" and s.playing >= s.maxPlayers - 1 then return s end
					if not best or s.playing > best.playing then best = s end
				end
			end
		end

		cursor = data.nextPageCursor
		if not cursor then break end
	end
	return best
end

local function moveTo(hum, position, token, timeout)
	local finished, success = false, false
	local conn = hum.MoveToFinished:Connect(function(ok)
		finished, success = true, ok
	end)

	hum:MoveTo(position)

	local t0 = os.clock()
	while not finished do
		if token ~= PrestineManager._token then
			conn:Disconnect()
			return "cancel"
		end
		if os.clock() - t0 > timeout then
			conn:Disconnect()
			return "timeout"
		end
		task.wait(0.05)
	end

	conn:Disconnect()
	return success and "ok" or "timeout"
end

local function walkTo(hum, hrp, cf, token)
	for _ = 1, 2 do
		local path = PathfindingService:CreatePath()
		path:ComputeAsync(hrp.Position, cf.Position)
		if path.Status ~= Enum.PathStatus.Success then return end

		local stuck = false
		for _, wp in ipairs(path:GetWaypoints()) do
			if token ~= PrestineManager._token then return end
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			local result = moveTo(hum, wp.Position, token, 3)
			if result == "cancel" then return end
			if result == "timeout" then
				stuck = true
				break
			end
		end

		if not stuck then return end
	end
end

local function tweenTo(mgr, hrp, cf, token)
	local dist = (hrp.Position - cf.Position).Magnitude
	local speed = math.max(tonumber(mgr.Config.TweenSpeed) or 1, 1)

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(dist / speed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = cf }
	)
	mgr._activeTween = tween

	local completed = false
	local conn = tween.Completed:Connect(function()
		completed = true
	end)

	local lastPos = hrp.Position
	local lastMoveT = os.clock()
	tween:Play()

	while not completed do
		if token ~= mgr._token then
			pcall(function() tween:Cancel() end)
			break
		end

		local p = hrp.Position
		if (p - lastPos).Magnitude > 0.15 then
			lastPos = p
			lastMoveT = os.clock()
		elseif os.clock() - lastMoveT > 2.5 then
			pcall(function() tween:Cancel() end)
			break
		end

		task.wait(0.05)
	end

	conn:Disconnect()
	mgr._activeTween = nil
end

function PrestineManager:GetTabEntry(name)
	for _, entry in ipairs(self.TabRegistry) do
		if entry.Name == name then
			return entry
		end
	end
	return nil
end

function PrestineManager:SetConfig(k, v)
	if self.Config[k] == nil then return end
	self.Config[k] = v
	if k == "TravelMethod" and not isValidMethod(v) then
		self.Config.TravelMethod = "Teleport"
	end

	local lib = getgenv().PrestineLib
	if lib and lib.Save and lib.Manager == self then
		pcall(function()
			lib._LastKey = nil
			lib:Save()
		end)
	end
end

function PrestineManager:Cancel()
	self._token += 1
	self._queue = {}
	self.State.Busy = false
	self.State.CurrentTask = "Cancelled"
	if self._activeTween then
		pcall(function() self._activeTween:Cancel() end)
		self._activeTween = nil
	end
end

function PrestineManager:Enqueue(target)
	table.insert(self._queue, target)
end

function PrestineManager:ClearQueue()
	self._queue = {}
end

function PrestineManager:_travel(cf, token)
	local hum, hrp = getHumanoidRoot()
	local method = self.Config.TravelMethod
	if not isValidMethod(method) then
		method = "Teleport"
		self.Config.TravelMethod = method
	end

	if method == "Teleport" then
		hrp.CFrame = cf
		local delay = tonumber(self.Config.TeleportDelay) or 0
		local t0 = os.clock()
		while os.clock() - t0 < delay do
			if token ~= self._token then return end
			task.wait()
		end
	elseif method == "Tween" then
		tweenTo(self, hrp, cf, token)
	else
		walkTo(hum, hrp, cf, token)
	end
end

function PrestineManager:StartQueue()
	if self.State.Busy then return end
	self.State.Busy = true
	self.State.CurrentTask = "Running"

	self._token += 1
	local token = self._token

	task.spawn(function()
		while #self._queue > 0 and token == self._token do
			local cf = toCFrame(table.remove(self._queue, 1))
			if cf then
				self:_travel(cf, token)
			end
		end

		if token == self._token then
			self.State.Busy = false
			self.State.CurrentTask = "Idle"
		end
	end)
end

function PrestineManager:Travel(target)
	if self.Config.QueueMode then
		self:Enqueue(target)
		self:StartQueue()
	else
		self:Cancel()
		self:Enqueue(target)
		self:StartQueue()
	end
end

function PrestineManager:CustomTravel(target, overrides)
	overrides = overrides or {}
	local cfg = self.Config
	local oldMethod, oldSpeed, oldDelay, oldQueue = cfg.TravelMethod, cfg.TweenSpeed, cfg.TeleportDelay, cfg.QueueMode

	if overrides.Method and isValidMethod(overrides.Method) then
		cfg.TravelMethod = overrides.Method
	end
	if overrides.Speed then
		cfg.TweenSpeed = math.max(1, tonumber(overrides.Speed) or cfg.TweenSpeed)
	end
	if overrides.TeleportDelay then
		cfg.TeleportDelay = math.max(0, tonumber(overrides.TeleportDelay) or 0)
	end
	if overrides.QueueMode ~= nil then
		cfg.QueueMode = overrides.QueueMode and true or false
	end

	self:Travel(target)

	task.spawn(function()
		while self.State.Busy do
			task.wait(0.1)
		end
		cfg.TravelMethod, cfg.TweenSpeed, cfg.TeleportDelay, cfg.QueueMode = oldMethod, oldSpeed, oldDelay, oldQueue
	end)
end

function PrestineManager:TravelMultiple(list)
	self:Cancel()
	for _, t in ipairs(list) do
		self:Enqueue(t)
	end
	self:StartQueue()
end

local function bindDeath(self, char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	if self._deathConn then self._deathConn:Disconnect() end
	self._deathConn = hum.Died:Connect(function()
		self:Cancel()
		self.State.CurrentTask = "Died"
	end)
end

function PrestineManager:_bindCharacterSafety()
	if self._charConn then self._charConn:Disconnect() end

	self._charConn = player.CharacterAdded:Connect(function(char)
		self:Cancel()
		self.State.CurrentTask = "Respawned"
		task.spawn(bindDeath, self, char)
		task.delay(1, function()
			if self._spyEnabled and self._spyTarget then
				setCameraToPlayer(self._spyTarget)
			end
		end)
	end)

	if player.Character then
		task.spawn(bindDeath, self, player.Character)
	end
end

local function lockReason(v)
	if v == true or v == nil or v == "" then return nil end
	return tostring(v)
end

function PrestineManager:LockFeature(name, reason, forceValue)
	self._locks[name] = (reason ~= nil and reason ~= "") and tostring(reason) or true
	local handle = self._handles[name]
	if handle and handle.Lock then
		handle:Lock(lockReason(self._locks[name]), forceValue)
	end
end

function PrestineManager:UnlockFeature(name)
	self._locks[name] = nil
	local handle = self._handles[name]
	if handle and handle.Unlock then
		handle:Unlock()
	end
end

function PrestineManager:LockFeatures(map)
	for name, reason in pairs(map or {}) do
		if reason == false then
			self:UnlockFeature(name)
		else
			self:LockFeature(name, reason)
		end
	end
end

function PrestineManager:IsFeatureLocked(name)
	return self._locks[name] ~= nil
end

function PrestineManager:GetFeature(name)
	return self._handles[name]
end

local function register(self, name, handle)
	if handle == nil then return nil end
	self._handles[name] = handle
	local pending = self._locks[name]
	if pending ~= nil and handle.Lock then
		handle:Lock(lockReason(pending))
	end
	return handle
end

local function choiceHandle(dd, choice)
	return {
		Lock = function()
			dd:LockChoice(choice)
			local cur = dd:Get()
			if type(cur) == "table" then
				local keep = {}
				for _, c in ipairs(cur) do
					if c ~= choice then keep[#keep + 1] = c end
				end
				if #keep ~= #cur then dd:Set(keep) end
			end
		end,
		Unlock = function()
			dd:UnlockChoice(choice)
		end,
	}
end

function PrestineManager:_setOptions(options)
	options = options or {}
	self._initOptions = options
	self._includeSet, self._excludeSet = nil, nil

	local include, exclude = options.IncludeFeatures, options.ExcludeFeatures
	if type(include) == "table" and #include > 0 then
		self._includeSet = {}
		for _, name in ipairs(include) do self._includeSet[name] = true end
	elseif type(exclude) == "table" then
		self._excludeSet = {}
		for _, name in ipairs(exclude) do self._excludeSet[name] = true end
	end

	if type(options.Locks) == "table" then
		self:LockFeatures(options.Locks)
	end
end

function PrestineManager:IsExcluded(featureName)
	if self._includeSet then return not self._includeSet[featureName] end
	if self._excludeSet then return self._excludeSet[featureName] == true end
	return false
end

function PrestineManager:_ensureAttached(PrestineLib)
	if type(PrestineLib) == "table" and type(PrestineLib.AttachManager) == "function" and PrestineLib.Manager ~= self then
		PrestineLib:AttachManager(self)
	end
end

function PrestineManager:SetupTab(tabName, PrestineLib, options)
	self:_ensureAttached(PrestineLib)

	if options then
		self:_setOptions(options)
	elseif not self._initOptions then
		self:_setOptions({})
	end

	local entry = self:GetTabEntry(tabName)
	if not entry then
		warn("[PrestineManager] SetupTab: unknown tab '" .. tostring(tabName) .. "'")
		return false
	end

	if not hasTab(entry.Name) then
		PrestineLib:CreateTab({ { Name = entry.Name, Icon = entry.Icon } })
	end

	self[entry.Setup](self, PrestineLib)
	return true
end

local function addSection(self, lib, tab, title)
	if self:IsExcluded(title) then return nil end
	return register(self, title, lib:AddSection({ Tab = tab, MainTitle = title }))
end

