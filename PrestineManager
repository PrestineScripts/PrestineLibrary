	addSection(self, PrestineLib, "Settings", "Movement Config")

	if not self:IsExcluded("Travel Method") then
		local choiceControls = {}

		if not self:IsExcluded("Tween Speed") then
			choiceControls["Tween"] = {
				{
					Key = "Tween Speed", Name = "Tween Speed", Type = "Slider",
					Min = 50, Max = 600, Increment = 10,
					Default = math.clamp(tonumber(self.Config.TweenSpeed) or 150, 50, 600),
				},
			}
		end

		if not self:IsExcluded("Teleport Delay") then
			choiceControls["Teleport"] = {
				{
					Key = "Teleport Delay", Name = "Delay (sec)", Type = "Number",
					Min = 0, Max = 10, Placeholder = "0 - 10",
					Default = tonumber(self.Config.TeleportDelay) or 0,
				},
			}
		end

		register(self, "Travel Method", PrestineLib:AddDropdown({
			Tab = "Settings",
			MainTitle = "Travel Method",
			Description = "Tween speed and teleport delay appear under their method",
			ChoiceList = { "Teleport", "Tween", "Walking" },
			Multiple = false,
			DefaultChoice = tostring(self.Config.TravelMethod),
			ChoiceControls = choiceControls,
			Callback = function(v, values)
				local m = firstValue(v)
				self.Config.TravelMethod = isValidMethod(m) and m or "Teleport"

				values = values or {}
				local speed = tonumber(values["Tween Speed"])
				if speed then self.Config.TweenSpeed = speed end
				local delay = tonumber(values["Teleport Delay"])
				if delay then self.Config.TeleportDelay = math.clamp(delay, 0, 10) end
			end
		}))
